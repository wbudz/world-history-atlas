<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Delete Empty Groups</name>
  <id>user.history_atlas.delete_empty_groups</id>

  <param name="include_layers" type="bool" gui-text="Also delete empty layers">false</param>

  <effect>
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="History Atlas"/>
    </effects-menu>
  </effect>

  <script>
    <command location="inx" interpreter="python">delete_empty_groups.py</command>
  </script>
</inkscape-extension>
