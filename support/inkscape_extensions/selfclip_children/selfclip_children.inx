<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Selfclip Children</name>
  <id>user.history_atlas.selfclip_children</id>
  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="History Atlas"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">selfclip_children.py</command>
  </script>
</inkscape-extension>
